generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Provider {
  id              String           @id @default(cuid())
  name            String           @unique
  baseUrl         String           @map("BaseUrl")
  authEnvKey      String           @map("AuthEnvKey")
  riskProfile     String           @default("LOW")
  promoBalance    Float            @default(0.0) @map("PromoBalance")
  billingCycleEnd DateTime?        @map("BillingCycleEnd")
  exhaustedUntil  DateTime?        @map("ExhaustedUntil")
  totalSpent      Float            @default(0.0) @map("TotalSpent")
  models          Model[]
}

model Model {
  id              String           @id @default(cuid())
  providerId      String
  name            String
  contextSize     Int
  provider        Provider         @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  arbitrageScores ArbitrageScore[]

  @@unique([name, providerId])
}

model ArbitrageScore {
  id              String    @id @default(cuid())
  modelId         String
  taskTag         String
  eloRating       Float
  cooldownUntil   DateTime?
  model           Model     @relation(fields: [modelId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([modelId, taskTag])
}
